 112          bit g_playing = 1;                     // 1=playing, 0=paused
 113          unsigned long g_address = 0;           // current frame address in SD
 114          unsigned char xdata frame_buf[4][176]; // 4 blocks frame buffer
 115          
 116          // read one frame (704 bytes) from SD and show it on LCD
 117          void readAndShowOneFrame(void) {
 118   1          SdReadBlock(frame_buf[0], g_address, 176); g_address += 176;
 119   1          SdReadBlock(frame_buf[1], g_address, 176); g_address += 176;
 120   1          SdReadBlock(frame_buf[2], g_address, 176); g_address += 176;
 121   1          SdReadBlock(frame_buf[3], g_address, 176); g_address += 176;
 122   1      
 123   1          dprintf_hanzi_string_1(frame_buf[0], 0, 0, 16, 0);
 124   1          dprintf_hanzi_string_1(frame_buf[1], 0, 16, 16, 0);
 125   1          dprintf_hanzi_string_1(frame_buf[2], 0, 32, 16, 0);
 126   1          dprintf_hanzi_string_1(frame_buf[3], 0, 48, 16, 0);
 127   1      }
 128          
 129          // play one note of the music
 130          void playOneNote(void) {
 131   1          if (FreqSelect == STOP) {
 132   2              TR0 = 0;
 133   2              g_playing = 0;               // music ends -> stop (keys still work)
 134   2          } else {
 135   2              FreqSelect = Music[MusicSelect][0];
 136   2              Delayms(140 * Music[MusicSelect][1]);
 137   2              MusicSelect++;
 138   2              TR0 = 0;
 139   2              Delayms(5);
 140   2              TR0 = 1;
 141   2          }
 142   1      }
 143          
 144          void main(void) {
 145   1          F12864_init();
 146   1          F12864_clear();
 147   1          write_commond(0x98);
 148   1          while (!SdInit());    // init SD card (must be done before reading)
 149   1          Timer0_Init();
 150   1          Timer1_Init();
 151   1      
 152   1          while (1) {
 153   2              // handle key command
 154   2              if (g_key) {
 155   3                  switch (g_key) {
 156   4                      case 1: g_playing = !g_playing; break;          // play/pause
 157   4                      case 2: readAndShowOneFrame(); break;           // next frame
 158   4                      case 3: if (g_address >= 704) {                 // prev frame
 159   5                                  g_address -= 704;
 160   5                                  readAndShowOneFrame();
 161   5                              }
 162   4                              break;
 163   4                      case 4: g_address = 0; g_playing = 0; break;    // stop
 164   4                  }
 165   3                  g_key = 0;
 166   3              }
 167   2      
 168   2              // auto play
 169   2              if (g_playing) {
 170   3                  readAndShowOneFrame();
 171   3                  playOneNote();
 172   3              }
 173   2          }
