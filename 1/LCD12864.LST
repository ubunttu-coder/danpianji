  60          //LCD初始化函数
  61          void F12864_init(void)
  62          { 
  63   1        REST = 0;
  64   1        delay_nms(2000);          
  65   1        REST = 1;
  66   1        write_ddc(0x40,0x00,0x00);                          //设置文本显示区首地址
  67   1        write_ddc(0x41,128/8,0x00);                       //设置文本显示区宽度
  68   1        write_ddc(0x42,0x00,0x08);                            //设置图形显示区首地址0x0800
  69   1        write_ddc(0x43,128/8,0x08);                       //设置图形显示区宽度
  70   1        write_commond(0xA0);                                      //设置光标形状 8x8方块
  71   1        write_commond(0x80);                                      //显示方式设置 文本and图形(异或)
  72   1        write_commond(0x92);                                      //设置光标
  73   1        write_commond(0x9F);                                      //显示开关设置 文本开,图形开,光标闪烁关               
  74   1      }
